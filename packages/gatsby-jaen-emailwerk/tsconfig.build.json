{
  // The emit, and only the emit.
  //
  // It has to produce CommonJS for Gatsby's node APIs, and "bundler" resolution
  // is not allowed alongside a CommonJS module target. The naive answer,
  // moduleResolution "node", is what broke this build: node10 ignores exports
  // maps, so Chakra v3's types come back incomplete and every element passing
  // only children fails TS2559 although the source is correct. "node16" honours
  // exports maps but demands explicit extensions on relative imports, which is
  // a different rewrite of every file in the package.
  //
  // So this config does not typecheck at all. The build passes --noCheck, and
  // the checking happens against tsconfig.json, which is on "bundler" because
  // that is how webpack actually resolves these modules at build time.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false
  }
}
